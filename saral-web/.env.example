# ───────────────────────── Saral AI website: environment variables ─────────────────────────
# Copy to .env.local for development. Variables prefixed NEXT_PUBLIC_ are exposed to the browser.

# Public site URL (canonical, sitemap, OG). Canonical host is www.
NEXT_PUBLIC_SITE_URL=https://www.saral.me

# Backend (FastAPI) that owns demo requests, booking sessions and payments.
# ONE documented default: http://127.0.0.1:8000
# NOTE: used at BUILD time by next.config.ts rewrites (/api/v1/*) and at RUNTIME by /api/demo-request.
BACKEND_URL=http://127.0.0.1:8000

# TODO(owner): official WhatsApp Business number, digits only with country code, e.g. 919XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
# TODO(owner): public support / sales email
NEXT_PUBLIC_SUPPORT_EMAIL=
# TODO(owner): social profile URLs (leave empty to hide the icon / link)
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Cloudflare Turnstile (demo form spam protection).
# Dev: Cloudflare's always-pass test keys are 1x00000000000000000000AA (site) and 1x0000000000000000000000000000000AA (secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (consent-gated). Leave empty to disable analytics entirely.
# Plausible example: saral.me
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
